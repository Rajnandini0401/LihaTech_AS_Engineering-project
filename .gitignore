# ==============================================================================
# .gitignore - A S Engineering Work Web Application & Backend
# ==============================================================================

# Node.js & Dependencies
node_modules/
.pnp/
.pnp.js

# Logs and Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data & PID files
pids/
*.pid
*.seed
*.pid.lock

# Build & Bundler Output
dist/
build/
out/
coverage/
.next/
.nuxt/
.parcel-cache/
.cache/
.turbo/

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Backup & Compressed Archives (Prevent bulky files like client.zip from being tracked)
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.bak
*.tmp
*.temp
*~

# Operating System Files
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Editor & IDE Directories
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Miscellaneous / Scratch
scratch/
tmp/
temp/
